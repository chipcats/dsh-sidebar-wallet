{
  "name": "dsh-sidebar-wallet",
  "version": "0.2.3",
  "description": "One-line DeepSeek balance and today's spend at the right end of the DSH sidebar account row, with a hover card.",
  "type": "module",
  "license": "MIT",
  "author": "chipcats",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chipcats/dsh-sidebar-wallet.git"
  },
  "homepage": "https://github.com/chipcats/dsh-sidebar-wallet#readme",
  "bugs": {
    "url": "https://github.com/chipcats/dsh-sidebar-wallet/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "balance",
    "sidebar",
    "wallet"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.1 <0.3.0-0",
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  }
}
